{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/quotation_frontend/browser",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/m",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/m/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/m/(.*)\\.(js|mjs|css|wasm|json|png|jpg|jpeg|gif|webp|svg|ico|ttf|otf|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/m",
      "destination": "/m/index.html"
    },
    {
      "source": "/m/(.*)",
      "destination": "/m/index.html"
    },
    {
      "source": "/((?!assets/|branding/|images/|m/).*)",
      "destination": "/index.html"
    }
  ]
}
